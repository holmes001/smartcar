    "version": "2.0.0",
    "tasks": [
        {
            "label": "build",
            "type": "shell",
            "command": "cmake",
            "args": [
                "--build", "${workspaceFolder}/build/Debug",
                "--config", "Debug",
                "--",
                "-j4"
            ],
            "options": { "cwd": "${workspaceFolder}" },
            "group": { "kind": "build", "isDefault": true },
            "problemMatcher": [ "$gcc" ],
            "presentation": { "reveal": "always", "panel": "shared", "clear": true }
        },
        {
            "label": "download",
            "type": "shell",
            "command": "openocd",
            "args": [
                "-f", "interface/stlink.cfg",
                "-c", "transport select swd",
                "-f", "target/stm32h7x.cfg",
                "-c", "adapter speed 480",
                // Flash 绠楁硶鐨勫伐浣滃尯浠庨粯璁ょ殑 DTCM(0x20000000) 鎸埌 AXI SRAM 鏈熬銆?                // 榛樿鍊间細璁?OpenOCD 鎶婄畻娉曞啓杩?DTCM锛屾湰鏉?+ ST-Link 鍏嬮殕鐗堜笅
                // 缁忓父鎶?"Failed to write memory at 0x20000b74"銆?                "-c", "stm32h7x.cpu0 configure -work-area-phys 0x24070000 -work-area-size 0x10000 -work-area-backup 0",
                "-c", "program build/Debug/smartcar.elf verify reset exit"
            ],
            "options": { "cwd": "${workspaceFolder}" },
            "dependsOn": [ "build" ],
            "group": { "kind": "build" },
            "problemMatcher": [],
            "presentation": { "reveal": "always", "panel": "shared", "clear": true }
        }
    ]
}
